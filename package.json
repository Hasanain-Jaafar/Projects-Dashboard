{
  "name": "projects-dashboard",
  "version": "1.0.0",
  "description": "A glassy, Apple-inspired dashboard for your local code projects",
  "main": "main.js",
  "desktopName": "projects-dashboard.desktop",
  "author": {
    "name": "Projects Dashboard",
    "email": "dev@projects-dashboard.local"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:deb": "electron-builder --linux deb"
  },
  "build": {
    "appId": "com.projectsdashboard.app",
    "productName": "Projects Dashboard",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "scanner.js",
      "capture.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon-256.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "assets/icon-256.png",
      "category": "Utility",
      "syncDesktopName": true,
      "synopsis": "A glassy dashboard for your local code projects",
      "description": "A glassy, Apple-inspired dashboard for your local code projects."
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0",
        "libappindicator3-1"
      ]
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.15.3"
  }
}
